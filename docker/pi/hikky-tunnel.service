[Unit]
Description=Tunnel SSH Hikky (Pi -> bot GPU RunPod)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/hikky-tunnel.env

# -N : pas de shell distant, uniquement le forwarding.
# -L : le port local 6666 du Pi est relayé vers le 6666 du pod.
# ExitOnForwardFailure : si le forward echoue, on sort pour que systemd
#   relance, au lieu de laisser un tunnel ouvert mais inutilisable.
# ServerAlive* : detecte une coupure reseau en ~30s au lieu d'attendre
#   le timeout TCP par defaut (plusieurs minutes).
ExecStart=/usr/bin/ssh -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new \
    -o BatchMode=yes \
    -i ${SSH_KEY} \
    -L 6666:localhost:6666 \
    -p ${POD_PORT} ${POD_USER}@${POD_HOST}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
