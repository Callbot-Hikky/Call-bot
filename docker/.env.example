# Copier vers .env et adapter au besoin. docker compose lit .env
# automatiquement dans le même dossier que docker-compose.yml.

# Adresse où Asterisk va joindre le bot Python (le serveur AudioSocket).
# Défaut : host.docker.internal (marche sur Docker Desktop Mac/Win et
# via extra_hosts sur Linux).
BOT_HOST=host.docker.internal
BOT_PORT=6666

# Mot de passe SIP pour l'extension 1000. Faible par défaut pour le
# confort du dev — à CHANGER pour toute démo publique ou en réseau
# non maîtrisé.
SIP_EXTENSION_PASSWORD=1000
